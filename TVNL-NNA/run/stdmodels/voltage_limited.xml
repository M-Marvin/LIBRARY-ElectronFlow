<?xml version="1.0" encoding="UTF-8"?>
<nodalElement name="UP2" nonLinear="true" timeVariant="false">
	<node name="p_A" constant="i_A"/>
	<node name="p_B" constant="i_B"/>
	<local name="i_src" constant="u_src"/>
	<variable name="U" default="1.0"/>
	<variable name="P" default="1.0"/>
	<variable name="eps" default="0.01"/>
	<functions><![CDATA[
		U_l(U,P,i_src):=0-i_src+U+P/U;
		
		h(U,eps):=(eps*U*sqrt(2))/2;
		o(U,P,eps):=P/U+eps*U-2*h(U,eps);
		
		U_t1(U,P,i_src,eps):=sqrt((eps*U)^2-(i_src-o(U,P,eps))^2))+U-eps*U;
		U_t2(U,P,i_src,eps):=sqrt((eps*U)^2-(i_src-o(U,P,eps))^2))+U-eps*U;
		
		U_t(U,P,i_src,eps):=sqrt((eps*U)^2-(i_src-o(U,P,eps))^2)+U-eps*U;
		
		U_src(U,P,i_src,eps):=0-i_src<P/U?U:U_l(U,P,i_src)<0.01?0.01:U_l(U,P,i_src);
		
		
		
	]]></functions>
	<stampA>
		<derive USd="U_src(U,P,i_src,eps)" var="i_src"/>
				p_A		p_B		i_src
		i_A		0.0		0.0		1.0
		i_B		0.0		0.0		-1.0
		u_src	1.0		-1.0	USd
	</stampA>
	<stampZ>
		<derive USd="U_src(U,P,i_src,eps)" var="i_src"/>
		<compute US="U_src(U,P,i_src,eps)"/>
		i_A		0.0
		i_B		0.0
		u_src	US-i_src*USd
	</stampZ>
</nodalElement>
