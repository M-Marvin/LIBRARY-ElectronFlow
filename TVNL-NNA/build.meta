import de.m_marvin.metabuild.java.script.JavaBuildScript;
import de.m_marvin.metabuild.maven.Maven;
import de.m_marvin.metabuild.maven.types.Repository;
import de.m_marvin.metabuild.maven.types.Repository.Credentials;

public class Buildfile extends JavaBuildScript {
	
	String version = "0.1-alpha-SNAPSHOT";
	
	@Override
	public void init() {
		
		projectName = "tvnl-nna";
		
		super.init();
		
		withSourcesJar();
		
		compileJava.sourceCompatibility = "17";
		compileJava.targetCompatibility = "17";
		

	}
	
	@Override
	public void repositories() {
		dependencies.repository(new Repository(
				"[GHP] BasicXML", 
				"https://maven.pkg.github.com/m-marvin/library-basicxml", 
				new Credentials(
						() -> System.getenv("GITHUB_ACTOR"), 
						() -> System.getenv("GITHUB_TOKEN")
				)
		));
		dependencies.repository(Maven.mavenCentral());
		dependencies.repository(Maven.mavenLocal());
	}
	
	@Override
	public void dependencies() {
		
		// BasicXML
		dependencies.implementation("de.m_marvin.basicxml:basicxml:1.1.7");

		// UniVec
		dependencies.implementation("de.m_marvin.univec:univec:1.9.0-SNAPSHOT");
		
		// NetLib
		dependencies.implementation("net.sourceforge.f2j:arpack_combined_all:0.1");
		dependencies.implementation("com.github.fommil.netlib:core:1.1.2");
		
		// NetLib natives (testing only)
		//dependencies.test("com.github.fommil.netlib:all:1.1.2::pom");
		
		// JFreeChart (testing only)
		dependencies.test("org.jfree:jfreechart:1.5.6");
		
	}
	
	@Override
	public void publishing() {
		
		super.publishing();
		
		publishMavenLocal.coordinates("de.m_marvin.electronflow:tvnl-nna:" + version);
		
		publishMaven.coordinates("de.m_marvin.electronflow:tvnl-nna:" + version);
		publishMaven.repository(new Repository(
				"GHP [ElectronFlow]",
				"https://maven.pkg.github.com/m-marvin/library-electronflow",
				new Credentials(
						() -> System.getenv("GITHUB_ACTOR"), 
						() -> System.getenv("GITHUB_TOKEN")
				)
		));
		
	}
	
}