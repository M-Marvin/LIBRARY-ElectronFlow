import de.m_marvin.metabuild.java.script.JavaBuildScript;
import de.m_marvin.metabuild.maven.Maven;
import de.m_marvin.metabuild.maven.types.Repository;
import de.m_marvin.metabuild.maven.types.Repository.Credentials;

public class Buildfile extends JavaBuildScript {
	
	String version = "0.3-alpha-SNAPSHOT";
	
	@Override
	public void init() {
		
		projectName = "electronflow-jnlti";
		
		super.init();
		
		compileJava.sourceCompatibility = "17";
		compileJava.targetCompatibility = "17";
		
		withSourcesJar();
		
	}
	
	@Override
	public void repositories() {
		
		dependencies.repository(new Repository(
				"[GHP] UniVec", 
				"https://maven.pkg.github.com/m-marvin/library-unifiedvectors", 
				new Credentials(
						() -> System.getenv("GITHUB_ACTOR"), 
						() -> System.getenv("GITHUB_TOKEN")
				)
		));

		dependencies.repository(Maven.mavenCentral());
		
		dependencies.repository(Maven.mavenLocal());
		
	}
	
	@Override
	public void manifest() {
		
		jar.metainfo.put("Implementation-Title", projectName);
		jar.metainfo.put("Implementation-Version", version);
		jar.metainfo.put("Author", "M_Marvin");
		
	}
	
	@Override
	public void dependencies() {
		
		dependencies.implementation("de.m_marvin.univec:univec:1.7.5");
		
		dependencies.implementation("org.ejml:ejml-dsparse:0.44.0");
		
	}
	
	@Override
	public void publishing() {
		super.publishing();
		
		publishMavenLocal.coordinates("de.m_marvin.electronflow:electronflow-jnlti:" + version);
		
		publishMaven.coordinates("de.m_marvin.electronflow:electronflow-jnlti:" + version);
		publishMaven.repository(new Repository(
				"[GHP] ElectronFlow",
				"https://maven.pkg.github.com/m-marvin/library-electronflow",
				new Credentials(
						() -> System.getenv("GITHUB_ACTOR"), 
						() -> System.getenv("GITHUB_TOKEN")
				)
		));
		
	}
	
}